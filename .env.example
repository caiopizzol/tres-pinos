# Gere segredos com: openssl rand -hex 32

# --- WAHA (a conexão com o WhatsApp) ---
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# --- Conector do WhatsApp ---
# A chave do conector, com pelo menos 32 caracteres. O agente a envia: Authorization: Bearer <chave>
WHATSAPP_KEY=
# Sessão do WAHA que o agente lê.
READ_SESSION=default
# Conversas que o agente pode ler: "saved" (só contatos salvos) ou "all".
READ_CHATS=saved
# Se o agente pode ler grupos, inclusive mensagens de quem você não salvou.
READ_GROUPS=false

# --- Transcrição (opcional) ---
# Ativa transcribe_audio e a transcrição dos vídeos. Com o Whisper nesta máquina:
# COMPOSE_PROFILES=whisper
# TRANSCRIBE_URL=http://whisper:8000/v1
# Ou com o Groq:
# TRANSCRIBE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_KEY=
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
