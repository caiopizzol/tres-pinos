# Gere cada senha e chave com: openssl rand -hex 32

# --- WAHA (a conexão com o WhatsApp) ---
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# --- Conector do WhatsApp ---
# Chave que o agente envia (Authorization: Bearer <chave>). Pelo menos 32 caracteres.
WHATSAPP_KEY=
# Sessão do WAHA que o agente lê.
READ_SESSION=default
# "saved": só conversas com contatos salvos. "all": todas.
READ_CHATS=saved
# "true" libera grupos, inclusive mensagens de quem você não salvou.
READ_GROUPS=false

# Serviços opcionais, separados por vírgula: "sicoob", "tunnel" (acesso pela internet), "whisper" (transcrição local).
# COMPOSE_PROFILES=sicoob,tunnel,whisper

# --- Acesso pela internet (opcional, com "tunnel") ---
# Para apps na internet entrarem com login. Veja connectors/whatsapp/docs/remote.md.
# PUBLIC_URL=https://whatsapp.seudominio.com
# TUNNEL_TOKEN=

# --- Transcrição (opcional) ---
# Ativa transcribe_audio e a fala dos vídeos. Com o Whisper nesta máquina, use "whisper" e:
# TRANSCRIBE_URL=http://whisper:8000/v1
# Ou com o Groq:
# TRANSCRIBE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_KEY=
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Conector do Sicoob (opcional, com "sicoob") ---
# Chave que o agente envia (Authorization: Bearer <chave>). Pelo menos 32 caracteres.
# SICOOB_KEY=
# Do app no portal de desenvolvedores do Sicoob.
# SICOOB_CLIENT_ID=
# Número da conta corrente, só dígitos.
# SICOOB_ACCOUNT=
# Pasta com sicoob.crt e sicoob.key, o certificado e-CPF convertido. Veja connectors/sicoob.
# SICOOB_CERT_DIR=./certificate
# A senha de sicoob.key.
# SICOOB_CERT_PASSWORD=
