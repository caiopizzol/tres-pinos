# Gere segredos com: openssl rand -hex 32

# --- WAHA (a conexão com o WhatsApp) ---
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# --- Conector do WhatsApp ---
GATEWAY_TOKEN=
# Sessão do WAHA que o agente lê. Vazio: sem ferramentas de leitura.
READ_SESSION=default
# Conversas que o agente pode ler: "saved" (só contatos salvos) ou "all".
READ_CHATS=saved
# Se o agente pode ler grupos, inclusive mensagens de quem você não salvou.
READ_GROUPS=false
# Sessão que envia, sempre só para contatos salvos. Vazio: sem envio.
SEND_SESSION=
# De qual celular vêm os contatos salvos. Padrão: READ_SESSION, senão SEND_SESSION.
# CONTACTS_SESSION=
# Opcional. Alertas quando uma sessão para. Use um nome longo e aleatório: wa-alerts-$(openssl rand -hex 16)
# NTFY_TOPIC=
# Opcional. Ativa transcribe_audio pelo Groq.
# GROQ_API_KEY=

# --- Acesso remoto (opcional, com --profile tunnel) ---
# O túnel da Cloudflare publica só /mcp, protegido por um aplicativo do Cloudflare Access.
# TUNNEL_TOKEN=
# ACCESS_TEAM_DOMAIN=https://<time>.cloudflareaccess.com
# ACCESS_AUD=<a tag AUD do aplicativo do Access>
# OWNER_EMAIL=<o único e-mail com acesso>
