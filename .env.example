# Conectores que sobem, separados por vírgula: sicoob, inter, nfse.
COMPOSE_PROFILES=sicoob
# Outra versão das imagens, como v0.1.0. Sem ela, a desta pasta, que está no compose.yaml.
# TRES_PINOS_VERSION=

# --- Conector do Sicoob ---
# Chave que o agente envia (Authorization: Bearer <chave>). Pelo menos 32 caracteres. Gere com: openssl rand -hex 32
SICOOB_KEY=
# Do app no portal de desenvolvedores do Sicoob.
SICOOB_CLIENT_ID=
# Número da conta corrente, só dígitos.
SICOOB_ACCOUNT=
# Pasta com sicoob.crt e sicoob.key, o certificado e-CPF convertido. Veja connectors/sicoob.
SICOOB_CERT_DIR=./certificate
# A senha de sicoob.key.
SICOOB_CERT_PASSWORD=
# Endereço público com HTTPS, para o seu app de IA entrar com login. Veja connectors/sicoob.
# SICOOB_PUBLIC_URL=https://sicoob.seudominio.com

# --- Conector do Inter ---
# Chave que o agente envia (Authorization: Bearer <chave>). Pelo menos 32 caracteres. Gere com: openssl rand -hex 32
# INTER_KEY=
# Da integração criada no Internet Banking do Inter.
# INTER_CLIENT_ID=
# INTER_CLIENT_SECRET=
# Pasta com inter.crt e inter.key. Veja connectors/inter.
# INTER_CERT_DIR=./certificate
# Endereço público com HTTPS, para o seu app de IA entrar com login. Veja connectors/inter.
# INTER_PUBLIC_URL=https://inter.seudominio.com

# --- Conector da NFS-e ---
# Chave que o agente envia (Authorization: Bearer <chave>). Pelo menos 32 caracteres. Gere com: openssl rand -hex 32
# NFSE_KEY=
# Pasta com nfse.crt e nfse.key, o certificado e-CNPJ convertido. Veja connectors/nfse.
# NFSE_CERT_DIR=./certificate
# A senha de nfse.key.
# NFSE_CERT_PASSWORD=
# Endereço público com HTTPS, para o seu app de IA entrar com login. Veja connectors/nfse.
# NFSE_PUBLIC_URL=https://nfse.seudominio.com
# restrita liga a emissão de notas no ambiente de teste, sem valor fiscal. Veja connectors/nfse.
# NFSE_ISSUE=restrita
# Com NFSE_ISSUE, o SHA-256 da chave com que você aprova cada nota. Veja connectors/nfse.
# NFSE_APPROVAL_HASH=
